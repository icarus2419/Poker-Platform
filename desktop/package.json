{
  "name": "poker-platform",
  "version": "1.0.0",
  "description": "Multiplayer poker platform — desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.josephdoylesomadi.poker",
    "productName": "Poker Platform",
    "files": [
      "main.js",
      "preload.js",
      "../index.html",
      "../src/**/*",
      "../styles/**/*",
      "../audio/**/*"
    ],
    "extraFiles": [
      {
        "from": "../../assets/poker-transition.css",
        "to": "assets/poker-transition.css"
      },
      {
        "from": "../../assets/poker-transition.js",
        "to": "assets/poker-transition.js"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
